# apps/api — Variables de entorno específicas del Backend NestJS
PORT=4000
NODE_ENV=development
TZ=America/Bogota

# Supabase / PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Auth
JWT_SECRET=koda_dev_access_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=koda_dev_refresh_secret_key_minimum_32_characters_random
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Google Drive Storage de Certificados
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=./config/google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=1_example_folder_id_for_certificates
